# ── Weather ──────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweathermap_api_key
OPENWEATHER_CITY=Thrissur,IN
OPENWEATHER_UNITS=metric          # metric | imperial | standard

# ── News ─────────────────────────────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key
NEWS_TOPICS=technology,science    # comma-separated topics
NEWS_COUNTRY=in                   # ISO country code
NEWS_MAX_ARTICLES=5

# ── Google Calendar ───────────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_JSON=credentials.json
GOOGLE_CALENDAR_ID=your_email@gmail.com

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_RECIPIENT=recipient@example.com
EMAIL_SUBJECT=☀️ Your Daily Briefing

# ── Scheduler ─────────────────────────────────────────────────────────────────
BRIEFING_TIME=07:00               # 24h format, local time

# ── AI Narrative (optional) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
ENABLE_AI_SUMMARY=false           # set to true to enable Claude narrative
